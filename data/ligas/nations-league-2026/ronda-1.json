91","strTimestamp":"2026-09-26T18:45:00","strEvent":"England vs Spain","strEventAlternate":"Spain @ England","strFilename":"UEFA Nations League 2026-09-26 England vs Spain","strSport":"Soccer","idLeague":"4490","strLeague":"UEFA Nations League","strLeagueBadge":"https://r2.thesportsdb.com/images/media/league/badge/cwsp321698386224.png","strSeason":"2026-2027","strDescriptionEN":"England begin their UEFA Nations League campaign with a major test against world champions Spain at Wembley, renewing the rivalry that produced the UEFA EURO 2024 final. Thomas Tuchel’s side return to League A looking to measure themselves against one of Europe’s strongest teams, while Spain arrive as reigning world champions and Nations League runners-up, with both sides targeting an immediate statement in a demanding Group A3.","strHomeTeam":"England","strAwayTeam":"Spain","intHomeScore":"2","intHomeScoreExtra":null,"intAwayScoreExtra":null,"intRound":"1","intAwayScore":"3","intSpectators":null,"strOfficial":"","strWeather":"","dateEvent":"2026-09-26","dateEventLocal":"2026-09-26","strTime":"18:45:00","strTimeLocal":"15:00:00","strGroup":"","idHomeTeam":"133914","strHomeTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/vf5ttc1726166739.png","idAwayTeam":"133909","strAwayTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/ncgqyr1726166942.png","intScore":"9","intScoreVotes":"1","strResult":"Spain opened their UEFA Nations League campaign with a dramatic 3-2 comeback victory over England at Wembley. Lamine Yamal gave the world champions a perfect start with a goal inside the opening minutes, but England responded strongly before half-time as Anthony Gordon equalised and Harry Kane headed the hosts into the lead. Kane then had a major opportunity to extend England’s advantage after the break, but his penalty struck the crossbar. Spain seized on the reprieve, with substitute Álex Baena restoring parity before setting up Mikel Oyarzabal for the winning goal in the 74th minute. The result gave Spain three points from a demanding opening fixture and extended their unbeaten run while England were left to rue the missed penalty that could have changed the direction of the match.","idVenue":"16163","strVenue":"Wembley Stadium","strCountry":"England","strCity":"London","strPoster":"","strSquare":"","strFanart":"https://r2.thesportsdb.com/images/media/event/fanart/7mi8rw1790497677.jpg","strThumb":"https://r2.thesportsdb.com/images/media/event/thumb/8tdb071786994300.jpg","strThumbAlternate":null,"strBanner":"","strMap":null,"strTweet1":"","strVideo":"","strStatus":"FT","strPostponed":"no","strLocked":"unlocked"},{"idEvent":"2442756","idAPIfootball":"1528892","strTimestamp":"2026-09-26T18:45:00","strEvent":"Czech Republic vs Croatia","strEventAlternate":"Croatia @ Czech Republic","strFilename":"UEFA Nations League 2026-09-26 Czech Republic vs Croatia","strSport":"Soccer","idLeague":"4490","strLeague":"UEFA Nations League","strLeagueBadge":"https://r2.thesportsdb.com/images/media/league/badge/cwsp321698386224.png","strSeason":"2026-2027","strDescriptionEN":"","strHomeTeam":"Czech Republic","strAwayTeam":"Croatia","intHomeScore":"1","intHomeScoreExtra":null,"intAwayScoreExtra":null,"intRound":"1","intAwayScore":"2","intSpectators":null,"strOfficial":"","strWeather":"","dateEvent":"2026-09-26","dateEventLocal":"2026-09-26","strTime":"18:45:00","strTimeLocal":"20:45:00","strGroup":"","idHomeTeam":"133904","strHomeTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/1o0cx31654205806.png","idAwayTeam":"133912","strAwayTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/84cfeg1789271106.png","intScore":null,"intScoreVotes":null,"strResult":"","idVenue":"18192","strVenue":"epet ARENA","strCountry":"Czechia","strCity":"","strPoster":"","strSquare":"","strFanart":null,"strThumb":"https://r2.thesportsdb.com/images/media/event/thumb/ioz8521786994301.jpg","strThumbAlternate":null,"strBanner":"","strMap":null,"strTweet1":"","strVideo