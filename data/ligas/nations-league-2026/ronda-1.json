{"events":[{"idEvent":"2442738","idAPIfootball":"1528862","strTimestamp":"2026-09-24T18:45:00","strEvent":"Netherlands vs Germany","strEventAlternate":"Germany @ Netherlands","strFilename":"UEFA Nations League 2026-09-24 Netherlands vs Germany","strSport":"Soccer","idLeague":"4490","strLeague":"UEFA Nations League","strLeagueBadge":"https://r2.thesportsdb.com/images/media/league/badge/cwsp321698386224.png","strSeason":"2026-2027","strDescriptionEN":"The Netherlands open their 2026/27 UEFA Nations League campaign with a heavyweight home clash against Germany in Amsterdam, renewing one of Europe’s most storied international rivalries. Ronald Koeman’s Oranje will look to make home advantage count after their World Cup campaign ended in the Round of 32, while Germany begin a new era under Jürgen Klopp in his first competitive match as national-team coach, adding further intrigue to an already high-profile Group A2 opener.","strHomeTeam":"Netherlands","strAwayTeam":"Germany","intHomeScore":"1","intHomeScoreExtra":null,"intAwayScoreExtra":null,"intRound":"1","intAwayScore":"1","intSpectators":"51347","strOfficial":"","strWeather":"","dateEvent":"2026-09-24","dateEventLocal":"2026-09-24","strTime":"18:45:00","strTimeLocal":"20:45:00","strGroup":"","idHomeTeam":"133905","strHomeTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/1p0hr41593787110.png","idAwayTeam":"133907","strAwayTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/1xysi51726167152.png","intScore":"8","intScoreVotes":"1","strResult":"The Netherlands rescued a 1-1 draw against Germany in dramatic fashion at the Johan Cruijff ArenA, denying Jürgen Klopp a winning start in his first match as Germany coach. Germany took the lead in the 32nd minute through Felix Nmecha and carried that advantage deep into the second half, with the visitors appearing set to open their Nations League campaign with three points. The Netherlands kept pushing, however, and were rewarded in stoppage time when Cody Gakpo struck in the 92nd minute to level the score. The late equaliser ensured Xavi Hernández also avoided defeat on his debut as Netherlands coach and left both sides with a point from their opening Group A2 fixture.","idVenue":"21448","strVenue":"Johan Cruijff ArenA","strCountry":"The Netherlands","strCity":"Amsterdam","strPoster":"","strSquare":"","strFanart":null,"strThumb":"https://r2.thesportsdb.com/images/media/event/thumb/u933271786994267.jpg","strThumbAlternate":null,"strBanner":"","strMap":null,"strTweet1":"","strVideo":"","strStatus":"FT","strPostponed":"no","strLocked":"unlocked"},{"idEvent":"2442739","idAPIfootball":"1528863","strTimestamp":"2026-09-24T18:45:00","strEvent":"Serbia vs Greece","strEventAlternate":"Greece @ Serbia","strFilename":"UEFA Nations League 2026-09-24 Serbia vs Greece","strSport":"Soccer","idLeague":"4490","strLeague":"UEFA Nations League","strLeagueBadge":"https://r2.thesportsdb.com/images/media/league/badge/cwsp321698386224.png","strSeason":"2026-2027","strDescriptionEN":"","strHomeTeam":"Serbia","strAwayTeam":"Greece","intHomeScore":"1","intHomeScoreExtra":null,"intAwayScoreExtra":null,"intRound":"1","intAwayScore":"2","intSpectators":null,"strOfficial":"","strWeather":"","dateEvent":"2026-09-24","dateEventLocal":"2026-09-24","strTime":"18:45:00","strTimeLocal":"20:45:00","strGroup":"","idHomeTeam":"136140","strHomeTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/oxvynb1689195538.png","idAwayTeam":"133902","strAwayTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/xtxtts1455465601.png","intScore":null,"intScoreVotes":null,"strResult":"","idVenue":"22942","strVenue":"Stadion Rajko Mitić","strCountry":"Serbia","strCity":"","strPoster":"","strSquare":"","strFanart":null,"strThumb":"https://r2.thesportsdb.com/images/media/event/thumb/ov6h8w1786994269.jpg","strThumbAlternate":null,"strBanner":"","strMap":null,"strTweet1":"","strVideo":"","strStatus":"FT","strPostponed":"no","strLocked":"unlocked"},{"idEven