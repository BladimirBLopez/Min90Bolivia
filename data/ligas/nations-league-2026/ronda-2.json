dge":"https://r2.thesportsdb.com/images/media/team/badge/g3slx61589798705.png","intScore":null,"intScoreVotes":null,"strResult":"","idVenue":"17327","strVenue":"Stadions Skonto","strCountry":"Latvia","strCity":"Riga","strPoster":"","strSquare":"","strFanart":null,"strThumb":"https://r2.thesportsdb.com/images/media/event/thumb/4k1a1v1786994332.jpg","strThumbAlternate":null,"strBanner":"","strMap":null,"strTweet1":"","strVideo":"","strStatus":"FT","strPostponed":"no","strLocked":"unlocked"},{"idEvent":"2442773","idAPIfootball":"1528909","strTimestamp":"2026-09-29T18:45:00","strEvent":"Spain vs Croatia","strEventAlternate":"Croatia @ Spain","strFilename":"UEFA Nations League 2026-09-29 Spain vs Croatia","strSport":"Soccer","idLeague":"4490","strLeague":"UEFA Nations League","strLeagueBadge":"https://r2.thesportsdb.com/images/media/league/badge/cwsp321698386224.png","strSeason":"2026-2027","strDescriptionEN":"Spain welcome Croatia to the Ramón Sánchez-Pizjuán for Matchday 2 of the 2026-27 UEFA Nations League, with both sides arriving after opening victories in Group A3. Spain return home for the first time since becoming two-time world champions and will look to build on their dramatic 3-2 win over England at Wembley, while Croatia arrive in Seville after defeating Czechia 2-1 in their opening match. Luis de la Fuente can call on a technically gifted squad led by Lamine Yamal, Pedri, Rodri and Mikel Oyarzabal, while Croatia continue to combine the experience of Luka Modrić with a younger generation seeking to maintain the country’s place among Europe’s leading national teams. With both sides level on three points, the match offers an early opportunity to take control of Group A3.","strHomeTeam":"Spain","strAwayTeam":"Croatia","intHomeScore":"4","intHomeScoreExtra":null,"intAwayScoreExtra":null,"intRound":"2","intAwayScore":"1","intSpectators":null,"strOfficial":"","strWeather":"","dateEvent":"2026-09-29","dateEventLocal":"2026-09-29","strTime":"18:45:00","strTimeLocal":"20:45:00","strGroup":"","idHomeTeam":"133909","strHomeTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/ncgqyr1726166942.png","idAwayTeam":"133912","strAwayTeamBadge":"https://r2.thesportsdb.com/images/media/team/badge/84cfeg1789271106.png","intScore":"8","intScoreVotes":"1","strResult":"Spain produced an emphatic 4-1 victory over Croatia in Seville to take sole control of UEFA Nations League Group A3. Lamine Yamal set the tone almost immediately, opening the scoring inside the first two minutes before Croatia responded through Dion Drena Beljo. Spain quickly restored their advantage when Marc Pubill headed in from Yamal’s delivery, and the hosts remained in control after the break. Yamal struck again in the second half to complete a superb individual performance before Nico Williams added a late fourth goal. The victory extended Spain’s unbeaten run and reinforced their strong start to the competition, while Yamal’s two goals and assist made him the standout figure of the night.","idVenue":"18689","strVenue":"Estadio Ramón Sánchez Pizjuán","strCountry":"Spain","strCity":"Seville","strPoster":"","strSquare":"","strFanart":null,"strThumb":"https://r2.thesportsdb.com/images/media/event/thumb/r4ahxe1786994334.jpg","strThumbAlternate":null,"strBanner":"","strMap":null,"strTweet1":"","strVideo":"","strStatus":"FT","strPostponed":"no","strLocked":"unlocked"},{"idEvent":"2442774","idAPIfootball":"1528910","strTimestamp":"2026-09-29T18:45:00","strEvent":"Czech Republic vs England","strEventAlternate":"England @ Czech Republic","strFilename":"UEFA Nations League 2026-09-29 Czech Republic vs England","strSport":"Soccer","idLeague":"4490","strLeague":"UEFA Nations League","strLeagueBadge":"https://r2.thesportsdb.com/images/media/league/badge/cwsp321698386224.png","strSeason":"2026-2027","strDescriptionEN":"","strHomeTeam":"Czech Republic","strAwayTeam":"England","intHomeScore":"0","intHomeScoreExtra":null,"intAwayScoreExtra":null,"intRound":"2","intAwayScore":"2"